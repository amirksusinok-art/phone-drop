# Phone Drop — Переменные окружения
PORT=3000

# Токен вашего бота от @BotFather (необходим для проверки подлинности пользователей в Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Опционально: строка подключения к PostgreSQL (например, на Render, Neon или Supabase)
# Если не указана, сервер автоматически использует встроенную базу SQLite в ./data/phonedrop.sqlite
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
